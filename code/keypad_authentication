/*
=================================================
 MATRIX KEYPAD PASSWORD-BASED DOOR LOCK SYSTEM
 Using ESP8266 NodeMCU + 4x4 Matrix Keypad
=================================================
*/

#include <Keypad.h>

// -------- PIN DEFINITIONS --------
#define RELAY_PIN D5
#define BUZZER_PIN D2

#define UNLOCK_TIME 3000
#define PASSWORD "2580"

// -------- 4x4 MATRIX KEYPAD --------
const byte ROWS = 4;
const byte COLS = 4;

char keys[ROWS][COLS] = {
  {'1','2','3','A'},
  {'4','5','6','B'},
  {'7','8','9','C'},
  {'*','0','#','D'}
};

// -------- ROW & COLUMN PINS --------
byte rowPins[ROWS] = {D0, D1, D3, D4};
byte colPins[COLS] = {D6, D7, D8, RX};

Keypad keypad = Keypad(makeKeymap(keys), rowPins, colPins, ROWS, COLS);

// -------- VARIABLES --------
String input = "";

// -------- SETUP --------
void setup() {

  Serial.begin(9600);

  pinMode(RELAY_PIN, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);

  digitalWrite(RELAY_PIN, HIGH);   // LOCKED
  digitalWrite(BUZZER_PIN, LOW);

  Serial.println("==================================");
  Serial.println(" Matrix Keypad Door Lock System");
  Serial.println("==================================");

  Serial.println("Enter Password:");
}

// -------- MAIN LOOP --------
void loop() {

  char key = keypad.getKey();

  if (!key) return;

  // -------- CLEAR INPUT --------
  if (key == '*') {

    input = "";

    Serial.println("\nInput Cleared");

    return;
  }

  // -------- ENTER KEY --------
  if (key == '#') {

    checkPassword();

    input = "";

    return;
  }

  // -------- STORE INPUT --------
  input += key;

  Serial.print("*");   // Hide password
}

// -------- PASSWORD VERIFICATION --------
void checkPassword() {

  if (input == PASSWORD) {

    unlockDoor();
  }
  else {

    accessDenied();
  }
}

// -------- UNLOCK DOOR --------
void unlockDoor() {

  Serial.println("\nAccess Granted");
  Serial.println("Door Unlocked");

  successBeep();

  digitalWrite(RELAY_PIN, LOW);    // Relay ON

  delay(UNLOCK_TIME);

  digitalWrite(RELAY_PIN, HIGH);   // Relay OFF

  Serial.println("Door Locked");
}

// -------- ACCESS DENIED --------
void accessDenied() {

  Serial.println("\nAccess Denied");

  deniedBeep();
}

// -------- SUCCESS BEEP --------
void successBeep() {

  digitalWrite(BUZZER_PIN, HIGH);

  delay(200);

  digitalWrite(BUZZER_PIN, LOW);
}

// -------- DENIED BEEP --------
void deniedBeep() {

  for (int i = 0; i < 3; i++) {

    digitalWrite(BUZZER_PIN, HIGH);
    delay(150);

    digitalWrite(BUZZER_PIN, LOW);
    delay(150);
  }
}
